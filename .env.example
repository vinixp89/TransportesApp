# Copie este arquivo pra ".env" (mesma pasta) e preencha com os valores reais.
# O ".env" NUNCA deve ser commitado (já está no .gitignore).

# Senha do Postgres — não use ; nem espaços.
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Chave secreta do JWT — string aleatória, pelo menos 32 caracteres. Gere uma com:
# openssl rand -base64 48
JWT_KEY=troque-por-uma-chave-aleatoria-bem-grande

# Mesma chave usada hoje em User Secrets (GoogleMaps:ApiKey e MercadoPago:AccessToken).
GOOGLEMAPS_APIKEY=
MERCADOPAGO_ACCESSTOKEN=

# URL pública do front-end (React) — usada tanto pra liberar no CORS quanto pro Mercado Pago
# redirecionar o cliente de volta depois do pagamento.
FRONTEND_URL=https://vainaboa.com.br

# URL pública da própria API (o domínio configurado no Caddyfile) + rota do webhook.
MERCADOPAGO_NOTIFICACAO_URL=https://api.vainaboa.com.br/api/Pagamentos/webhook

# Conta de Admin criada automaticamente no primeiro start, se ainda não existir.
ADMIN_EMAIL=admin@vainaboa.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte

# SMTP pra enviar e-mails (boas-vindas, código de redefinição de senha). Se for usar uma caixa
# da HostGator, esses dados aparecem no painel de e-mails do domínio (Configurações de cliente
# de e-mail / IMAP-SMTP).
SMTP_HOST=mail.vainaboamobilidade.com.br
SMTP_PORT=465
SMTP_USER=contato@vainaboamobilidade.com.br
SMTP_PASSWORD=
SMTP_FROM=contato@vainaboamobilidade.com.br
SMTP_ENABLESSL=true
